---
import { siteConfig } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/(?:\.html)?\/?$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="shortcut icon" type="image/png" href={`${base}/favicon.png`} />
    <meta name="google-site-verification" content="R0xdvBEYFTxfn0RxHhquiA6tBgvshYv3ODk-oNSuq4g" />
  </head>
  <body class="bg-white text-gray-900">
    <div class="max-w-screen-md mx-auto">
      <!-- Site Header -->
      <div id="site-header" class="flex items-center justify-between py-4 border-b mb-4">
        <a href={`${base}/`} id="site-logo" class="flex items-center">
          <img src={`${base}/favicon.png`} alt="Logo" />
          <span class="ml-4 font-semibold text-lg">{siteConfig.title}</span>
        </a>
        <div class="flex text-sm gap-2">
          {siteConfig.socialLinks.map((item) => (
            <a
              class="text-white px-1"
              style={`background: ${item.color}`}
              href={item.link}
              target="_blank"
              rel="noreferrer"
            >
              {item.text}
            </a>
          ))}
        </div>
      </div>

      <!-- Main Columns -->
      <div class="flex mb-4 items-start">
        <nav class="w-1/4 border shadow-sm rounded p-2 text-sm flex flex-col flex-shrink-0">
          {siteConfig.sidebar.map((group, i) => (
            <>
              {group.items.map((item) => {
                const targetPath = `${base}${item.link}`;
                const isActive = currentPath === targetPath;
                return (
                  <a
                    class={isActive ? "px-2 py-1 rounded m-px bg-gray-800 text-white" : "px-2 py-1 rounded m-px hover:bg-gray-200"}
                    href={targetPath}
                  >
                    {item.text}
                  </a>
                );
              })}
              {i < siteConfig.sidebar.length - 1 && <hr class="my-1 mx-2" />}
            </>
          ))}
        </nav>
        <article class="w-3/4 ml-8 markdown-body">
          <slot />
        </article>
      </div>
    </div>
  </body>
</html>
