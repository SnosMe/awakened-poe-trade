---
import { siteConfig } from '../config.js';
import '../styles/global.css';
import FundingBanner from '../pages/donate/_FundingBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/(?:\.html)?\/?$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="shortcut icon" type="image/png" href={`${base}/favicon.png`} />
    <meta name="google-site-verification" content="R0xdvBEYFTxfn0RxHhquiA6tBgvshYv3ODk-oNSuq4g" />
  </head>
  <body>
    <div class="page-container">
      <!-- Site Header -->
      <header class="site-header-container">
        <div class="site-header">
          <a href={`${base}/`} class="site-logo">
            <img src={`${base}/favicon.png`} alt="Logo" />
            <div class="title">
              <div class="primary">{siteConfig.title}</div>
              <div class="secondary">v{siteConfig.appVersion}</div>
            </div>
          </a>
          <div class="header-actions">
            <div class="social-links">
              {siteConfig.socialLinks.map((item) => (
                <a
                  class="social-link"
                  style={{ backgroundColor: item.color }}
                  href={item.link.startsWith('/') ? `${base}${item.link}` : item.link} target="_blank"
                >
                  {item.text}
                </a>
              ))}
            </div>
            <button id="_menuToggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="_siteNav">
              Menu
            </button>
          </div>
        </div>
        <FundingBanner id="_banner" class="banner" />
      </header>

      <!-- Main Columns -->
      <div class="main-columns">
        <nav id="_siteNav" class="site-nav">
          {siteConfig.sidebar.map((group, i) => (
            <>
              {group.items.map((item) => {
                const targetPath = `${base}${item.link}`;
                const isActive = currentPath === targetPath;
                return (
                  <a
                    class:list={[{ active: isActive }]}
                    href={targetPath}
                  >
                    {item.text}
                  </a>
                );
              })}
              {i < siteConfig.sidebar.length - 1 && <hr />}
            </>
          ))}
        </nav>
        <article class="markdown-body">
          <slot />
        </article>
      </div>

      <footer class="site-footer">
        <p>&copy; <span id="_copyYear">2020-present</span> Alexander Drozdov</p>
        <p class="max-w-sm">This product isn't affiliated with or endorsed by Grinding Gear Games in any way.</p>
      </footer>
    </div>
  </body>
</html>

<script is:inline>
const yearEl = document.getElementById('_copyYear');
if (yearEl) {
  yearEl.textContent = new Date().getFullYear().toString();
}
</script>

<script>
const toggleBtn = document.getElementById('_menuToggle');
const siteNav = document.getElementById('_siteNav');
const bannerEl = document.getElementById('_banner');

toggleBtn?.addEventListener('click', () => {
  const isOpen = siteNav?.classList.toggle('open');
  toggleBtn.setAttribute('aria-expanded', String(isOpen));
  if (bannerEl) {
    bannerEl.style.display = isOpen ? 'none' : '';
  }
});
</script>

<style>
html {
  overflow-y: scroll;
  @apply bg-white text-gray-900;
}

.page-container {
  max-width: theme('screens.md');
  margin: 0 auto;
  --x-padding: theme('spacing.4');
}

.site-header-container {
  display: flex;
  flex-direction: column;
}

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: theme('spacing.2') theme('spacing.12');
  padding: var(--x-padding);
}

.site-logo {
  display: flex;
  align-items: center;

  & > img {
    width: theme('spacing.12');
    height: theme('spacing.12');
    flex-shrink: 0;
  }

  & > .title {
    display: flex;
    flex-direction: column;
    gap: theme('spacing.1');
    margin-left: theme('spacing.2');
    line-height: 1;
    white-space: nowrap;

    & > .primary {
      font-size: theme('fontSize.xl');
      @apply font-semibold;
    }

    & > .secondary {
      font-size: theme('fontSize.xs');
      color: theme('colors.gray.700');
    }
  }
}

.header-actions {
  flex: 1;
  display: flex;
  align-items: center;
  gap: theme('spacing.2');
}

.social-links {
  display: flex;
  gap: theme('spacing.2');
}

.social-link {
  @apply text-white;
  background-clip: padding-box;
}

.social-link, .menu-toggle {
  padding: 0 theme('spacing.2');
  @apply border border-transparent;
  text-align: center;
  line-height: theme('height.7');
  min-width: 4.375rem;
}

.menu-toggle {
  flex: 1;
  color: theme('colors.gray.900');
  background-color: theme('colors.white');
  border-color: theme('colors.gray.300');
  @apply font-semibold;

  &:hover {
    background-color: theme('colors.gray.100');
  }
}

.main-columns {
  display: flex;
  flex-direction: column;
}

.site-nav {
  display: none;

  &.open {
    display: flex;
    flex-direction: column;
    padding: 0 var(--x-padding);
    margin-bottom: var(--x-padding);
  }
}

.site-nav a {
  @apply py-1 text-gray-600;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;

  &:hover {
    color: theme('colors.gray.900');
    text-decoration: underline;
  }

  &.active {
    color: theme('colors.gray.900');
    @apply font-semibold;
  }
}

.site-nav hr {
  @apply my-1 mx-2;
}

article {
  @apply bg-white;
  padding: var(--x-padding);
  width: 100%;
  min-width: 0;
}

.site-footer {
  @apply mt-8;
  padding: theme('spacing.4') var(--x-padding);
  @apply text-sm text-gray-500;
  @apply border-t border-gray-200;
}

@media (width >= 768px) {
  body {
    @apply text-sm;
  }

  .page-container {
    --x-padding: theme('spacing.6');
  }

  .site-header-container {
    margin-top: theme('spacing.12');
  }

  .banner {
    margin-bottom: theme('spacing.4');
  }

  .site-header {
    flex-wrap: nowrap;
    padding: theme('spacing.4') 0;
  }

  .site-header-container, .site-footer {
    margin-left: calc(theme('width.44') + theme('spacing.4'));
  }

  .site-logo {
    & > .title {
      margin-left: theme('spacing.4');

      & > .primary {
        font-size: theme('fontSize.lg');
      }
    }
  }

  .header-actions {
    flex: 0;
  }

  .menu-toggle {
    display: none;
  }

  .social-link {
    line-height: theme('height.6');
    min-width: 0;
  }

  .main-columns {
    flex-direction: row;
    align-items: flex-start;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    width: theme('width.44');
    padding: 0;
    margin-bottom: 0;
  }

  .site-nav a {
    @apply px-2;

    &.active {
      background: linear-gradient(to right, theme('colors.gray.100'), theme('colors.white'));
    }
  }

  article {
    @apply border;
    margin-left: theme('spacing.4');
  }

  .site-footer {
    border: none;
    margin-top: 0;
  }
}
</style>
