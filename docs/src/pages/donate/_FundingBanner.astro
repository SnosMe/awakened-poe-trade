---
import type { HTMLAttributes } from 'astro/types';
import * as fs from 'node:fs';

interface Props extends Pick<HTMLAttributes<'div'>, 'id' | 'class'> {
}

const { class: className, ...attrs } = Astro.props;

interface Patron {
  from: string;
  months: number;
  style: number;
}

const patrons: Patron[] = JSON.parse(
  fs.readFileSync(new URL('../../../../renderer/public/data/patrons.json', import.meta.url), { encoding: 'utf8' }));

const activeCount = 0; // TODO
const formerCount = 0; // TODO

// visible on all pages
const allTimeTop = patrons.filter(entry => entry.style >= 5);
// randomized per page & per each static site deployment
const randomPickPool = patrons.filter(entry => entry.style < 5);
const randPicked: Patron[] = [];
while (randPicked.length < allTimeTop.length && randomPickPool.length) {
  const index = Math.floor(Math.random() * randomPickPool.length);
  randPicked.push(randomPickPool.splice(index, 1)[0]);
}

const names = [...allTimeTop, ...randPicked].map(entry => (entry.from));

function shuffle (array: unknown[]): void {
  let currentIndex = array.length;
  while (currentIndex !== 0) {
    const randomIndex = Math.floor(Math.random() * currentIndex);
    currentIndex--;
    [array[currentIndex], array[randomIndex]] =
      [array[randomIndex], array[currentIndex]];
  }
}

shuffle(names);

const scrollSpeed = `${(names.length * 1.100).toFixed(3)}s`;
---

<div class:list={["banner", className]} data-nosnippet {...attrs}>
  <p>Updates continue thanks to {activeCount} active and {formerCount} former supporters.</p>
  <div class="become-row">
    <!-- TODO fix link -->
    <a href="#">Become one of heroes&nbsp;&raquo;</a>
    <div class="names" aria-hidden="true">
      <span>{names.join('\n')}</span>
    </div>
  </div>
</div>

<style define:vars={{ scrollSpeed }}>
.banner {
  position: relative;
  z-index: 0;
  overflow: hidden;
  padding: theme('spacing.3') var(--x-padding);
  color: theme('colors.white');
  text-shadow: 1px 1px 2px theme('colors.black');
  text-wrap-style: pretty;

  & a {
    color: theme('colors.blue.300');
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    background: rgb(0 0 0 / 20%);
  }
}

.banner::before,
.banner::after {
  content: "";
  position: absolute;
  z-index: -1;
  pointer-events: none;
}

.banner::before {
  top: 0;
  left: 0;
  --tile-w: 512px;
  --tile-h: 512px;
  width: calc(100% + var(--tile-w));
  height: calc(100% + var(--tile-h));
  background-image: url(/ShaperTiled.png);
  background-repeat: repeat;
  background-size: var(--tile-w) var(--tile-h);
  animation: tiled-scroll 60s linear infinite;
}

@keyframes tiled-scroll {
  from {
    transform: translate3d(0, 0, 0);
  }
  to {
    transform: translate3d(calc(var(--tile-w) * -1), calc(var(--tile-h) * -1), 0);
  }
}

.become-row {
  display: flex;
  gap: theme('spacing.2');
  white-space: nowrap;
  align-items: start;
}

.names {
  overflow: hidden;
  display: inline-block;
  height: 1lh;
  vertical-align: bottom;

  & > span {
    display: inline-block;
    animation: names-scroll var(--scrollSpeed) linear infinite;
    animation-delay: 350ms;
    animation-fill-mode: backwards;
    white-space: pre;
  }
}

@keyframes names-scroll {
  from { transform: translate3d(0, 1lh, 0); }
  to { transform: translate3d(0, -100%, 0); }
}

@media (width < 768px) {
  .become-row {
    margin-top: theme('spacing.1');
  }

  .names {
    flex: 1;
    text-align: center;
  }
}

@media (width >= 768px) {
  .banner::after {
    inset: 0;
    border: 2px solid rgb(255 255 255 / 80%);
    outline: 1px solid theme('colors.gray.900');
    outline-offset: -1px;
  }
}
</style>
